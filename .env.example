# Planned environment variables. Nothing reads them yet; the auth and storage
# phases implement them. Copy to .env.local for local development.

# Auth.js (ADR 0004)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Numeric GitHub user ID of the only allowed user (not the login name).
ALLOWED_GITHUB_USER_ID=

# GitHub App installed only on the data repo (ADR 0003)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Repo the storage layer reads and writes (ADR 0002)
GITHUB_REPO_OWNER=Jackson-Dataciders
GITHUB_REPO_NAME=Mineforge
GITHUB_DATA_BRANCH=main
