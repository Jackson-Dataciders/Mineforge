# All environment variables. Copy to .env.local for local development and set
# the same values in Vercel (Production and Preview). Never commit real values.

# Auth.js (ADR 0004). Generate AUTH_SECRET with `npx auth secret`.
AUTH_SECRET=
# GitHub OAuth app for login; callback URL: <app-url>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Optional: only needed outside Vercel if the app URL can't be detected.
# AUTH_URL=http://localhost:3000
# Numeric GitHub user ID of the only allowed user (not the login name),
# e.g. from https://api.github.com/users/<login> → "id".
ALLOWED_GITHUB_USER_ID=

# GitHub App installed only on the data repo, permission Contents: read & write (ADR 0003)
GITHUB_APP_ID=
# PEM private key; literal "\n" sequences are converted to newlines.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Repo the storage layer reads and writes (ADR 0002)
GITHUB_REPO_OWNER=Jackson-Dataciders
GITHUB_REPO_NAME=Mineforge
GITHUB_DATA_BRANCH=main

# Dev-only fake mode: in-memory data and automatic login, honored only under
# `next dev` and never on Vercel (ADR 0014). Leave unset normally.
# MINEFORGE_DEV_FAKE=1
# Optional, fake mode only: seed the fake store from a folder with extracted
# data/ and assets/textures/ (e.g. tools/extract-jar.ts --out <folder>).
# MINEFORGE_DEV_SEED_DIR=
